MYSQL_ROOT_PASSWORD=root

# Bootstrap admin: created in the `users` table (role "admin") on app startup if
# no user with this email exists yet. ADMIN_USERNAME is used as the login email.
# Optional - if either is blank, bootstrapping is skipped.
# Generate the hash with:
#   new BCryptPasswordEncoder().encode("your-password")
# Wrap it in single quotes: bcrypt hashes contain literal $ characters that
# docker compose would otherwise try to interpolate as variable references.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
