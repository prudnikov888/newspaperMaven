<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <parent>
        <artifactId>newspaperSpring</artifactId>
        <groupId>newspaperSpring</groupId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
  <artifactId>web</artifactId>
  <packaging>jar</packaging>
  <version>2.0.0-SNAPSHOT</version>
  <name>web</name>
  <url>http://maven.apache.org</url>

  <dependencies>
      <dependency>
          <groupId>newspaperSpring</groupId>
          <artifactId>dao</artifactId>
          <version>${newspaperSpring.version}</version>
      </dependency>
      <dependency>
          <groupId>newspaperSpring</groupId>
          <artifactId>services</artifactId>
          <version>${newspaperSpring.version}</version>
      </dependency>

      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-web</artifactId>
      </dependency>
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-thymeleaf</artifactId>
      </dependency>
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-security</artifactId>
      </dependency>
      <dependency>
          <!-- Boot 4 moved Liquibase autoconfiguration into its own module, pulled in only via
               this starter (plain liquibase-core alone does not activate it) -->
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-liquibase</artifactId>
      </dependency>
      <dependency>
          <!-- Not managed by the Spring Boot BOM; VERIFY latest version on Maven Central -->
          <groupId>nz.net.ultraq.thymeleaf</groupId>
          <artifactId>thymeleaf-layout-dialect</artifactId>
          <version>4.0.0</version>
      </dependency>
      <dependency>
          <!-- VERIFY: artifact suffix must match the Spring Security major version the
               chosen Boot 4.x BOM actually bundles (springsecurity6 vs a possible springsecurity7) -->
          <groupId>org.thymeleaf.extras</groupId>
          <artifactId>thymeleaf-extras-springsecurity6</artifactId>
      </dependency>

      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-test</artifactId>
          <scope>test</scope>
      </dependency>
      <dependency>
          <groupId>org.springframework.security</groupId>
          <artifactId>spring-security-test</artifactId>
          <scope>test</scope>
      </dependency>
  </dependencies>

  <build>
    <finalName>web</finalName>
    <plugins>
        <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
    </plugins>
  </build>
</project>
